{
  "name": "minisk1510g1app",
  "version": "1.1.0",
  "description": "Mini-SK-01",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "portaDoPrograma": 7742,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikonadvogadomgalt.minisk01.pc",
    "productName": "Mini-SK-01",
    "executableName": "mini-sk-01",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "**/*",
      "!android/**",
      "!.github/**",
      "!release/**",
      "!node_modules/.cache/**",
      "!*.zip",
      "!.sk/**",
      "!apk.config.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mini-SK-01",
      "artifactName": "mini-sk-01-Instalar.exe"
    },
    "portable": {
      "artifactName": "mini-sk-01-sem-instalar.exe"
    }
  }
}
